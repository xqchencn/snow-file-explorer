{
  "name": "snow-plugin-file-explorer",
  "version": "1.0.6",
  "description": "Snow App File Explorer Plugin with syntax highlighting and git status",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "generate": "node tools/generate.mjs",
    "sync:host": "node tools/sync-host-api.mjs",
    "check:host": "node tools/sync-host-api.mjs --check",
    "check:types": "tsc --noEmit",
    "lint": "eslint src build.js tools",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run check:host && npm run lint && npm run check:types && npm run build && npm test"
  },
  "keywords": [
    "snow-app",
    "snow-plugin",
    "file-explorer"
  ],
  "author": "xqchen",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "lucide": "^1.50.0",
    "marked": "^18.0.14",
    "material-icon-theme": "^5.39.0",
    "prismjs": "^1.30.0"
  }
}
